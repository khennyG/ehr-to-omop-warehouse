# Warehouse backend: "duckdb" for a zero-install local/demo run, "postgres" for the
# docker-compose stack. See src/config/settings.py.
WAREHOUSE_BACKEND=duckdb
DUCKDB_PATH=./data/processed/omop_demo.duckdb

# Database (used when WAREHOUSE_BACKEND=postgres)
POSTGRES_USER=omop
POSTGRES_PASSWORD=omop_dev
POSTGRES_DB=omop_cdm
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Paths
SYNTHEA_OUTPUT_DIR=./data/raw/synthea
VOCABULARY_DIR=./data/vocabularies
PROCESSED_DIR=./data/processed

# Pipeline
SYNTHEA_POPULATION=10000
LOG_LEVEL=INFO
